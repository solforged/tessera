#!/usr/bin/env bash
# Git's generated messages do not use the house commit convention.
set -euo pipefail
subject=''
IFS= read -r subject < "$1" || true
case "$subject" in
  'Merge '*|'Revert '*|'fixup! '*|'squash! '*|'amend! '*) exit 0 ;;
esac

if command -v mise >/dev/null 2>&1; then
  exec mise exec -- vale --no-global --path=COMMIT_EDITMSG < "$1"
fi
exec vale --no-global --path=COMMIT_EDITMSG < "$1"
