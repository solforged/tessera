#!/usr/bin/env bash
# Git's generated messages do not use the house commit convention.
set -euo pipefail
subject=''
IFS= read -r subject < "$1" || true
case "$subject" in
  'Merge '*|'Revert '*|'fixup! '*|'squash! '*|'amend! '*) exit 0 ;;
esac

# The pinned Vale is in Tessera's devenv shell; a commit from outside it, such
# as from an editor or another project's shell, enters it for this check.
if [ ! -d "${DEVENV_ROOT:-/nonexistent}/crates/tessera-core" ] && command -v devenv >/dev/null 2>&1; then
  exec devenv --quiet shell -- vale --no-global --path=COMMIT_EDITMSG < "$1"
fi
exec vale --no-global --path=COMMIT_EDITMSG < "$1"
