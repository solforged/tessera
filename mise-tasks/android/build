#!/usr/bin/env bash
#MISE description="Build the Android app; arguments go to `tauri android build`"
#MISE depends=["android:pages"]
#MISE tools={java="temurin-21", android-sdk="23.0"}
# Without arguments, builds a debug APK for arm64 phones under
# crates/tessera-android/gen/android/app/build/outputs/apk. mise provides the
# JDK and the Android SDK; the SDK must hold an NDK, or NDK_HOME must name one.
set -euo pipefail

source "$MISE_PROJECT_ROOT/mise-tasks/android/ndk.sh"
bun install --cwd crates/tessera-android --frozen-lockfile --silent
if [ $# -eq 0 ]; then
  set -- --debug --target aarch64 --apk
fi
bun run --silent --cwd crates/tessera-android tauri android build --ci "$@"
