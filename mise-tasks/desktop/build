#!/usr/bin/env bash
#MISE description="Build Tessera.app for this Mac; arguments go to `tauri build`"
#MISE depends=["web:build"]
# Writes target/release/bundle/macos. TESSERA_BUILD names the build; it
# defaults to the short commit, marked -dirty for uncommitted edits. With
# TAURI_SIGNING_PRIVATE_KEY set, the build also writes the signed updater
# archive.
set -euo pipefail

if [ -z "${TESSERA_BUILD:-}" ]; then
  TESSERA_BUILD=$(git rev-parse --short HEAD)
  [ -z "$(git status --porcelain)" ] || TESSERA_BUILD="$TESSERA_BUILD-dirty"
fi
export TESSERA_BUILD
host=$(rustc -vV | sed -n 's/^host: //p')
# Cargo and Tauri write wherever CARGO_TARGET_DIR points, so the sidecar must
# come from there too, or a stale ./target copy ships.
target_dir=${CARGO_TARGET_DIR:-target}

cargo build --quiet --release --locked -p tessera-cli --features embed-web
mkdir -p crates/tessera-desktop/binaries
cp "$target_dir/release/tessera" "crates/tessera-desktop/binaries/tessera-$host"

config='"externalBin":["binaries/tessera"]'
if [ -z "${TAURI_SIGNING_PRIVATE_KEY:-}" ]; then
  config="$config,\"createUpdaterArtifacts\":false"
fi
bun install --cwd crates/tessera-desktop --frozen-lockfile --silent
bun run --silent --cwd crates/tessera-desktop tauri build --ci --config "{\"bundle\":{$config}}" "$@"
