#!/usr/bin/env bash
#MISE description="Copy the shared Voice prose style from the system checkout into .vale/styles"
#USAGE arg "[source]" help="The system checkout's Vale directory. Defaults to ~/src/system/config/vale."
#
# The Voice style is maintained in the system repository and shared by every
# project; Tessera commits a copy so that `mise run docs:lint` and CI need
# nothing outside the checkout. Run this after changing the style there, then
# `mise run docs:test` and `mise run docs:lint`, and commit the result.
set -euo pipefail

src=${usage_source:-$HOME/src/system/config/vale}
root=$(git rev-parse --show-toplevel)
if [ ! -d "$src/styles/Voice" ]; then
  echo "docs:style: no Voice style at $src/styles/Voice" >&2
  exit 1
fi

rsync -a --delete "$src/styles/Voice/" "$root/.vale/styles/Voice/"
# Views shared with the style (Commit) are copied beside Tessera's own.
mkdir -p "$root/.vale/styles/config/views"
rsync -a "$src/styles/config/views/" "$root/.vale/styles/config/views/"
echo "docs:style: copied $src/styles into .vale/styles"
