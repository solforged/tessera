  const lastContact = out.block(fieldsPage, 'Last contact');
  const stage = out.block(fieldsPage, 'Stage');
  const stages = Object.fromEntries(['Seedling', 'Budding', 'Evergreen'].map(name => [name, out.block(stage, name)]));
  const rating = out.block(fieldsPage, 'Rating');
  const owned = out.block(fieldsPage, 'Owned');
  const website = out.block(fieldsPage, 'Website');
