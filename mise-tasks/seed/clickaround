#!/usr/bin/env bun
//MISE description="Seed a workshop with a realistic past week for clickarounds; arguments: [dir] [--replace]"
//
// Writes a fresh workshop (default ~/.local/share/tessera/workshops/clickaround)
// holding the week ending today: journal days, two projects with tasks, clocked
// work and completions, repeating routines, people and concept pages with typed
// fields in every kind, empty and multi-value entries, meeting templates and
// nested field owners, flashcards with a week of review history, the bundled
// Meditations EPUB with highlights and a reading position, three catalogue
// records, two collections and saved views. Everything goes through a throwaway
// service's HTTP API, so it is the same data the app would write. The workshop is added
// to this computer's workshop list, so Settings → Workshops can open it.
//
// Dates are relative to the day it runs. Run it again with --replace to start
// over on a new week; it refuses while a service has the workshop open.

import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { dirname, isAbsolute, join, resolve } from 'node:path';

const root = resolve(import.meta.dir, '../..');
const args = process.argv.slice(2);
const replace = args.includes('--replace');
const positional = args.filter(arg => !arg.startsWith('--'));
const unknown = args.filter(arg => arg.startsWith('--') && arg !== '--replace');
if (unknown.length || positional.length > 1) fail(`usage: mise run seed:clickaround [dir] [--replace]`);
const xdg = (variable: string, fallback: string) => process.env[variable] && isAbsolute(process.env[variable]!) ? process.env[variable]! : join(homedir(), fallback);
const dir = resolve((positional[0] ?? join(xdg('XDG_DATA_HOME', '.local/share'), 'tessera/workshops/clickaround')).replace(/^~(?=$|\/)/, homedir()));

function fail(message: string): never {
  console.error(`seed: ${message}`);
  process.exit(1);
}

// ---------------------------------------------------------------- preflight

if (existsSync(join(dir, 'notebook.db'))) {
  if (!replace) fail(`${dir} already holds a workshop; pass --replace to seed it again`);
  const holder = heldBy(dir);
  if (holder) fail(`${dir} is open in the service with PID ${holder}; switch away from it or stop that service first`);
} else if (existsSync(dir) && !replace) {
  fail(`${dir} exists but holds no workshop; remove it or pass --replace`);
}

/** The PID in the service's ownership file when that process is still alive. The file is advisory, but a live PID means a service probably has the notebook open. */
function heldBy(notebook: string): number | null {
  try {
    const { pid } = JSON.parse(readFileSync(join(notebook, 'service.lock'), 'utf8')) as { pid?: number };
    if (!pid) return null;
    process.kill(pid, 0);
    return pid;
  } catch {
    return null;
  }
}

const bin = process.env.TESSERA_BIN ?? buildCli();
function buildCli(): string {
  console.log('seed: building tessera-cli');
  const build = Bun.spawnSync(['cargo', 'build', '-q', '--locked', '-p', 'tessera-cli'], { cwd: root, stdout: 'inherit', stderr: 'inherit' });
  if (build.exitCode !== 0) fail('cargo build failed');
  const metadata = Bun.spawnSync(['cargo', 'metadata', '--no-deps', '--format-version', '1'], { cwd: root });
  return join(JSON.parse(metadata.stdout.toString()).target_directory, 'debug', 'tessera');
}

// The seed is written beside the target and moved into place only when complete.
const staging = `${dir}.seeding`;
rmSync(staging, { recursive: true, force: true });
mkdirSync(dirname(dir), { recursive: true });

const port = await freePort();
const base = `http://127.0.0.1:${port}`;
const log = `${staging}.log`;
const { TESSERA_WORKSHOP: _, ...env } = process.env;
const service = Bun.spawn([bin, '--workshop', staging, 'serve', '--port', String(port), '--sync-port', '0'], {
  stdout: Bun.file(log), stderr: Bun.file(log), env,
});

async function freePort(): Promise<number> {
  const server = Bun.listen({ hostname: '127.0.0.1', port: 0, socket: { data() {} } });
  const { port } = server;
  server.stop(true);
  return port;
}

async function ready() {
  for (let attempt = 0; attempt < 200; attempt++) {
    if (service.exitCode !== null) throw new Error(`the service exited with ${service.exitCode}`);
    try {
      if ((await fetch(`${base}/api/service`)).ok) return;
    } catch { /* not listening yet */ }
    await Bun.sleep(50);
  }
  throw new Error('the service did not start within 10 s');
}

/** Add the workshop to the app's Workshops list, keeping the current choice. Same file and shape as `notebooks.rs`. */
function register(path: string) {
  const file = join(xdg('XDG_STATE_HOME', '.local/state'), 'tessera', 'workshops.json');
  let stored: { current?: string | null; notebooks?: string[] } = {};
  if (existsSync(file)) stored = JSON.parse(readFileSync(file, 'utf8'));
  const notebooks = stored.notebooks ?? [];
  if (notebooks.includes(path)) return;
  mkdirSync(dirname(file), { recursive: true });
  writeFileSync(`${file}.tmp`, JSON.stringify({ current: stored.current ?? null, notebooks: [...notebooks, path] }, null, 2));
  renameSync(`${file}.tmp`, file);
}

// ---------------------------------------------------------------- API

type Json = Record<string, unknown>;
type Operation = Json & { op: string };
interface Committed { revisions: { id: string; revision: number }[]; cards: { id: string; revision: number }[]; work_sessions: { id: string; revision: number }[]; review_sessions: { id: string; revision: number }[] }

async function api<T>(method: string, path: string, body?: unknown, headers: Record<string, string> = {}): Promise<T> {
  const binary = body instanceof Uint8Array;
  const response = await fetch(base + path, {
    method,
    headers: { Origin: base, ...(body !== undefined && !binary ? { 'Content-Type': 'application/json' } : {}), ...headers },
    body: body === undefined ? undefined : binary ? body : JSON.stringify(body),
  });
  const text = await response.text();
  if (!response.ok) throw new Error(`${method} ${path}: ${response.status} ${text}`);
  return text ? JSON.parse(text) as T : undefined as T;
}

const crockford = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
function ulid(): string {
  let time = Date.now(), head = '';
  for (let i = 0; i < 10; i++) { head = crockford[time % 32] + head; time = Math.floor(time / 32); }
  const random = crypto.getRandomValues(new Uint8Array(16));
  return head + Array.from(random, byte => crockford[byte % 32]).join('');
}

/** Revisions of everything the seed has written, from batch receipts. */
const revision = new Map<string, number>();
const cardRevision = new Map<string, number>();
const sessionRevision = new Map<string, number>();

async function commit(operations: Operation[], reason: string): Promise<Committed> {
  if (!operations.length) throw new Error(`empty batch: ${reason}`);
  const receipt = await api<Committed>('POST', '/api/batches', { actor: { kind: 'client', name: 'clickaround seed' }, reason, idempotency_key: ulid(), operations })
    .catch((error: Error) => { throw new Error(`${reason}: ${error.message}\n${JSON.stringify(operations).slice(0, 600)}`); });
  for (const { id, revision: value } of receipt.revisions) revision.set(id, value);
  for (const { id, revision: value } of receipt.cards) cardRevision.set(id, value);
  for (const { id, revision: value } of receipt.work_sessions) sessionRevision.set(id, value);
  for (const { id, revision: value } of receipt.review_sessions) sessionRevision.set(id, value);
  return receipt;
}

/** Revision-checked operations on blocks, one batch per call so each base revision is the current one. */
async function on(id: string, build: (base: number) => Operation, reason: string) {
  const base = revision.get(id);
  if (base === undefined) throw new Error(`no revision for ${id} (${reason})`);
  return commit([build(base)], reason);
}

/** Outline writer: pages, journal days and blocks appended in order, committed as one batch. */
class Outline {
  operations: Operation[] = [];
  private last = new Map<string, string>();
  page(title: string, id = ulid()) { this.operations.push({ op: 'create_page', id, title }); return id; }
  journal(date: string) { const id = ulid(); this.operations.push({ op: 'create_journal', id, date }); return id; }
  block(parent: string, text: string, heading: 1 | 2 | 3 | null = null) {
    const id = ulid();
    this.operations.push({ op: 'insert', id, parent_id: parent, after: this.last.get(parent) ?? null, text, heading });
    this.last.set(parent, id);
    return id;
  }
  after(parent: string, sibling: string | null) { if (sibling) this.last.set(parent, sibling); }
  /** A field entry with its value blocks, as `Name:: value` becomes in the editor. */
  field(owner: string, field: string, ...values: string[]) {
    const entry = this.block(owner, `[[${field}]]`);
    for (const value of values) this.block(entry, value);
    return entry;
  }
  async commit(reason: string) { const receipt = await commit(this.operations, reason); this.operations = []; this.last.clear(); return receipt; }
}

// ---------------------------------------------------------------- dates

const now = new Date();
const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const shift = (days: number) => new Date(midnight.getFullYear(), midnight.getMonth(), midnight.getDate() + days);
const iso = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const day = (offset: number) => iso(shift(offset));
const at = (offset: number, time: string) => { const [h, m] = time.split(':').map(Number); const date = shift(offset); date.setHours(h, m); return Math.min(date.getTime(), Date.now() - 60_000); };
const nextSunday = (7 - midnight.getDay()) % 7 || 7;
const firstOfNextMonth = iso(new Date(midnight.getFullYear(), midnight.getMonth() + 1, 1));
const link = (id: string) => `[[${id}]]`;

type Priority = 'high' | 'medium' | 'low';
interface Task { status?: 'todo' | 'doing' | 'waiting'; scheduled?: string; time?: string; deadline?: string; warning?: number; repeat?: [number, 'day' | 'week' | 'month' | 'year', 'fixed' | 'catch_up' | 'after_completion']; priority?: Priority }
const taskState = (task: Task) => ({
  status: task.status ?? 'todo', scheduled: task.scheduled ?? null, scheduled_time: task.time ?? null,
  deadline: task.deadline ?? null, deadline_time: null, warning_days: task.warning ?? null,
  repeater: task.repeat ? { every: task.repeat[0], unit: task.repeat[1], mode: task.repeat[2] } : null,
  priority: task.priority ?? null, completed_on: null,
});

// ---------------------------------------------------------------- seed

async function seed() {
  const { page_id: fieldsPage } = await api<{ page_id: string }>('GET', '/api/fields');
  const out = new Outline();

  // Types, fields and their templates.
  const person = out.page('Person');
  const concept = out.page('Concept');
  const vocabulary = out.page('Italian word');
  const place = out.page('Place');
  const meeting = out.page('Meeting');
  const role = out.block(fieldsPage, 'Role');
