#!/usr/bin/env bash
# Build the Tessera Android app. Without arguments it builds a debug APK for
# arm64 phones; otherwise the arguments go to `tauri android build`. The APK
# lands under crates/tessera-android/gen/android/app/build/outputs/apk.
#
# Needs a JDK and the Android SDK with an NDK. JAVA_HOME, ANDROID_HOME and
# NDK_HOME are used when set; otherwise they come from mise (java,
# android-sdk), and NDK_HOME is the newest NDK in the SDK.
set -euo pipefail

root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
if [ -z "${JAVA_HOME:-}" ]; then
  JAVA_HOME=$(mise where java 2>/dev/null) || { echo "Set JAVA_HOME to a JDK (17 or newer)." >&2; exit 1; }
fi
if [ -z "${ANDROID_HOME:-}" ]; then
  ANDROID_HOME=$(mise where android-sdk 2>/dev/null) || { echo "Set ANDROID_HOME to the Android SDK." >&2; exit 1; }
fi
if [ -z "${NDK_HOME:-}" ]; then
  NDK_HOME=$(find "$ANDROID_HOME/ndk" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -n 1)
  [ -n "$NDK_HOME" ] || { echo "Install an NDK into $ANDROID_HOME/ndk or set NDK_HOME." >&2; exit 1; }
fi
export JAVA_HOME ANDROID_HOME NDK_HOME

bun install --cwd web --frozen-lockfile --silent
# Vite's chunk-size warning is noise here; show the output only on failure.
if ! out=$(bun run --silent --cwd web build:android 2>&1); then
  echo "$out" >&2
  exit 1
fi
bun install --cwd crates/tessera-android --frozen-lockfile --silent
if [ $# -eq 0 ]; then
  set -- --debug --target aarch64 --apk
fi
bun run --silent --cwd crates/tessera-android tauri android build --ci "$@"
