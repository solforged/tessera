#!/usr/bin/env bash
# Lint commit messages with the shared Voice convention
# Usage: ts-commit-lint [range]
# The range defaults to origin/main..HEAD.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
case ${1-} in -*) echo "usage: ts-commit-lint [range]" >&2; exit 2 ;; esac
[ $# -le 1 ] || { echo "usage: ts-commit-lint [range]" >&2; exit 2; }
range=${1:-origin/main..HEAD}
commits=$(git log --no-merges --format='%H%x09%an' "$range")
status=0
while IFS=$'	' read -r sha author; do
  [ -n "$sha" ] || continue
  [ "$author" != 'dependabot[bot]' ] || continue
  if ! git log -1 --format=%B "$sha" | vale --no-global --path=COMMIT_EDITMSG; then
    echo "commit:lint: $sha failed" >&2
    status=1
  fi
done <<< "$commits"
exit "$status"
