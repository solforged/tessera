#!/usr/bin/env bash
# Build a commit (default HEAD) into Tessera.app and make it the live app on
# this Mac.
#
# Builds in a separate worktree, so uncommitted edits never ship. Replaces
# /Applications/Tessera.app, then runs its `tessera install`, which backs up
# the notebook, restarts the launch agent on port 4318 with the new build and
# waits for it. If the new build does not answer, install restores the backup
# with the previous build and puts that build back; this script then puts the
# previous app back too.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
commit=$(git -C "$root" rev-parse --verify "${1:-HEAD}^{commit}")
build=$(git -C "$root" rev-parse --short "$commit")
cache="$HOME/Library/Caches/tessera"
src="$cache/ship"
app=/Applications/Tessera.app
cli="$app/Contents/MacOS/tessera"
plist="$HOME/Library/LaunchAgents/dev.tessera.serve.plist"
url="http://127.0.0.1:4318"

service() { curl -fsS --max-time 2 "$url/api/service" 2>/dev/null; }
agent_program() { plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null || true; }

if service | grep -q "\"build\":\"$build\"" && [ "$(agent_program)" = "$cli" ]; then
  echo "ship: $build is already live at $url"
  exit 0
fi

echo "ship: building $build"
if [ -e "$src/.git" ]; then
  git -C "$src" checkout --quiet --detach --force "$commit"
  git -C "$src" clean -fdq
else
  mkdir -p "$cache"
  git -C "$root" worktree add --quiet --detach "$src" "$commit"
fi
TESSERA_BUILD="$build" "$src/scripts/build-desktop" --bundles app >/dev/null

# Replacing the app replaces the binary the agent may run, so keep a copy to
# roll back to.
rollback=()
previous=$(agent_program)
if [ -n "$previous" ] && [ -x "$previous" ]; then
  cp "$previous" "$cache/tessera.prev"
  rollback=(--rollback "$cache/tessera.prev")
fi

running=false
if pgrep -qf "$app/Contents/MacOS/tessera-desktop"; then
  running=true
  osascript -e 'quit app id "dev.tessera.app"'
fi
rm -rf "$app.next" "$app.prev"
ditto "$src/target/release/bundle/macos/Tessera.app" "$app.next"
[ -e "$app" ] && mv "$app" "$app.prev"
mv "$app.next" "$app"

if "$cli" install ${rollback[@]+"${rollback[@]}"} >/dev/null; then
  rm -rf "$app.prev"
  # The command line follows the app.
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$cli" "$HOME/.local/bin/tessera"
  rm -f "$HOME/.local/bin/tessera.prev"
  echo "ship: $build is live at $url"
  status=0
else
  echo "ship: $build did not come up" >&2
  if [ -e "$app.prev" ]; then
    rm -rf "$app"
    mv "$app.prev" "$app"
    echo "ship: put the previous Tessera.app back" >&2
  fi
  status=1
fi
if $running; then
  open "$app"
fi
exit $status
