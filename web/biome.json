{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["src/**", "perf/**", "*.ts", "*.json", "!src/api/wire.ts", "!src/demo/pkg", "!perf/results"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "recommended": false,
        "useKeyWithClickEvents": "error",
        "useButtonType": "error",
        "noSvgWithoutTitle": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "noUselessFragments": "off",
        "useIndexOf": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noShadowRestrictedNames": "off",
        "noControlCharactersInRegex": "off",
        "noConfusingVoidType": "off",
        "useIterableCallbackReturn": "off",
        "noImplicitAnyLet": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/api/**", "src/core/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../api/**", "!../core/**", "!../../api/**", "!../../core/**"],
                    "message": "api and core are the base layer: they import only each other. Move the shared code down here instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/model/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "!../api/**",
                      "!../core/**",
                      "!../model/**",
                      "!../../api/**",
                      "!../../core/**",
                      "!../../model/**"
                    ],
                    "message": "model imports only api, core and model. Keep stateful or UI helpers in document, ui or workflows."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/document/*",
        "src/ui/*",
        "!src/document/*/**",
        "!src/ui/*/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../api/**", "!../core/**", "!../model/**", "!../document/**", "!../ui/**"],
                    "message": "document and ui import only api, core, model, document and ui. Move cross-surface orchestration into workflows or a feature."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/document/*/**", "src/ui/*/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../../**",
                      "!../../api/**",
                      "!../../core/**",
                      "!../../model/**",
                      "!../../document/**",
                      "!../../ui/**"
                    ],
                    "message": "document and ui import only api, core, model, document and ui. Move cross-surface orchestration into workflows or a feature."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/**",
        "!src/main.tsx",
        "!src/shell/**",
        "!src/mobile/**",
        "!src/demo/**",
        "!src/api/**",
        "!src/core/**",
        "!src/model/**",
        "!src/document/**",
        "!src/ui/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../shell/**",
                      "../../shell/**",
                      "../mobile/**",
                      "../../mobile/**",
                      "../demo/**",
                      "../../demo/**"
                    ],
                    "message": "Features and workflows never import shell or platform entrypoints. Move shared primitives to ui, model or workflows."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
