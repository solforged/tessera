{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["src/**", "perf/**", "*.ts", "*.json", "!src/api/wire.ts", "!src/demo/pkg", "!perf/results"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": "off",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off",
        "noUselessFragments": "off",
        "useIndexOf": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noShadowRestrictedNames": "off",
        "noControlCharactersInRegex": "off",
        "noConfusingVoidType": "off",
        "useIterableCallbackReturn": "off",
        "noImplicitAnyLet": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/api/**", "src/core/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../api/**", "!../core/**"],
                    "message": "api and core are the base layer: they import only each other. Move the shared code down here instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../api/**", "!../core/**"],
                    "message": "ui imports only api and core. Move a feature's component into that feature instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
